{
	"schemaVersion": 1,
	"id": "magnesium",
	"version": "${version}",
	"name": "Magnesium",
	"description": "An addon to Sodium that provides a Metal backend for Minecraft on macOS. (REQUIRES MACOS 26.0+)",
	"authors": [
		"turkfork"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/magnesium/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"turkfork.magnesium.Magnesium"
		],
		"client": [
			"turkfork.magnesium.client.MagnesiumClient"
		]
	},
	"mixins": [
		"magnesium.mixins.json",
		{
			"config": "magnesium.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}